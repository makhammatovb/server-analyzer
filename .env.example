# Copy to .env (mode 0600) and edit. `make up` reads it. Never commit .env.

# Public origin of the dashboard. It must EXACTLY equal the Origin the browser
# sends: scheme, host and any non-default port. If it differs, every
# state-changing request (login, add server, ...) is refused with 403, and the
# install command shown for new servers points at the wrong place.
# It also needs a DNS record to this host: Caddy obtains an ACME certificate for it.
FG_BASE_URL=https://fleet.example.com

# Public origin of the agents. A DIFFERENT hostname from FG_BASE_URL, also
# pointing at this host. It presents a certificate from the fleet CA, which
# agents pin, so it cannot share a hostname with the ACME-certified dashboard:
# if they were the same, agents would enrol and then fail every request. The
# server refuses to start if the two hosts are equal.
FG_AGENT_URL=https://agents.example.com

# Shared secret between Caddy and the backend, which requires it on every
# request. It is what stops another local process, or a server-side request
# forgery, reaching the backend directly. If it is empty the stack will not
# start; if the two ends disagree every request is answered 401.
#   openssl rand -hex 32
FG_PROXY_SECRET=

# Database password. Required, no default. It is placed in a connection URL, so
# use letters and digits only:  openssl rand -hex 24
FG_DB_PASSWORD=

# Optional: create the first administrator on start if none exists. Set both or
# neither (the server refuses to start with one). Ignored once an admin exists;
# remove the password from this file afterwards.
FG_BOOTSTRAP_USER=
FG_BOOTSTRAP_PASSWORD=
