# syntax=docker/dockerfile:1
FROM caddy:2.10-alpine
# Caddy is the internet-facing process, so it runs as its own user (10002), NOT
# the server's (10001), and mounts only the "fgproxy" volume: the agent
# certificate pair and a public copy of ca.crt. It reads them as group 10002; the
# directory is owned by the server (10001) so the server can write it. The CA
# private key lives in a volume this container does not mount.
RUN addgroup -g 10002 fgproxy && adduser -D -u 10002 -G fgproxy fgproxy \
 && install -d -m 2750 -o 10001 -g 10002 /proxy-certs \
 && install -d -m 0700 -o 10002 -g 10002 /caddy/data /caddy/config
# Caddy cannot load the agent certificate before the server has issued it, and
# the server starts after Caddy (it shares Caddy's network namespace), so wait.
COPY <<'SH' /usr/local/bin/caddy-when-ready
#!/bin/sh
d=/proxy-certs
until [ -s "$d/agent-server.crt" ] && [ -s "$d/agent-server.key" ] && [ -s "$d/ca.crt" ]; do
  echo "waiting for the server to issue the agent certificate in $d" >&2
  sleep 1
done
exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
SH
RUN chmod 0755 /usr/local/bin/caddy-when-ready
USER 10002:10002
ENV XDG_DATA_HOME=/caddy/data XDG_CONFIG_HOME=/caddy/config
CMD ["/usr/local/bin/caddy-when-ready"]
